# dev_tool templates/rust/justfile @2.0.0
# Copied once, then this repository's own. Needs `sh` on PATH (Windows: Git for Windows' `Git\bin`);
# tools: `mise install`. The gate's flags are the cargo aliases in .cargo/config.toml, which CI's
# rust-ci.yml and `takt check` run too.

default:
    @just --list

# What CI runs, less its MSRV job.
[group('gate')]
check: fmt-check lint test doc deny

[group('gate')]
fmt-check:
    cargo fmt --all --check

[group('gate')]
lint:
    cargo lint

[group('gate')]
test *args:
    cargo test-all {{ args }}

# rustdoc warnings denied, as CI runs it.
[group('gate')]
doc:
    RUSTDOCFLAGS=-Dwarnings cargo doc-check

[group('gate')]
deny:
    cargo deny check

[group('dev')]
build:
    cargo build --release

[group('dev')]
run *args:
    cargo run {{ args }}

[group('dev')]
watch:
    bacon

[group('dev')]
fmt:
    cargo fmt --all

[group('dev')]
clean:
    cargo clean

[group('deps')]
outdated:
    cargo update --dry-run --verbose

[group('deps')]
upgrade:
    cargo update

[group('deps')]
tree-dup:
    cargo tree --duplicates

# Operator only: gate; cargo-release bumps every crate, commits and pushes (release.toml); then, once
# CI has passed on that commit, tag vX.Y.Z, which a library's publish.yml publishes.
[group('operator')]
[script]
release version:
    [ -t 0 ] || { echo "release is an operator command: run it from a terminal"; exit 2; }
    just check
    cargo release "{{ version }}" --execute
    sha="$(git rev-parse HEAD)"
    run=""
    for _ in $(seq 1 30); do
      run="$(gh run list --commit "$sha" --workflow ci.yml --json databaseId --jq '.[0].databaseId')"
      [ -n "$run" ] && break
      sleep 10
    done
    [ -n "$run" ] || { echo "no CI run for $sha within 5 minutes: tag it by hand once it is green"; exit 1; }
    gh run watch "$run" --exit-status || { echo "CI failed on $sha: not tagged"; exit 1; }
    git tag "v{{ version }}"
    git push --quiet origin "v{{ version }}"
    echo "pushed v{{ version }}"
