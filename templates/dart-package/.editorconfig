# dev_tool templates/dart-package/.editorconfig @1.0.0
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# 120 columns: lints_tool's `formatter: page_width`.
[*.dart]
max_line_length = 120

[justfile]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
