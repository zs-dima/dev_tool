# dev_tool templates/dart-package/justfile @2.0.0
# Copied once, then this repository's own. Needs `sh` on PATH (Windows: Git for Windows' `Git\bin`).

# `flutter` for a package that needs the Flutter SDK (and flutter-gate.yml in CI).
TOOL := 'dart'

default:
    @just --list

# What CI's gate runs.
[group('gate')]
check: format-check analyze test publish-check

# Hand-written Dart only: generated `*.*.dart` stays as its generator emits it.
[group('gate')]
format-check:
    git ls-files -z -- '*.dart' ':(exclude,glob)**/*.*.dart' | xargs -0 -r dart format --output=none --set-exit-if-changed

[group('gate')]
analyze:
    {{ if TOOL == "flutter" { "flutter analyze" } else { "dart analyze --fatal-infos --fatal-warnings" } }}

[group('gate')]
test *args:
    {{ TOOL }} test --test-randomize-ordering-seed=random {{ args }}

[group('gate')]
publish-check:
    {{ TOOL }} pub publish --dry-run

# Local only: the DCM licence is a secret a fork's CI cannot see.
[group('gate')]
dcm:
    dcm analyze .

[group('dev')]
get:
    {{ TOOL }} pub get

[group('dev')]
format:
    git ls-files -z -- '*.dart' ':(exclude,glob)**/*.*.dart' | xargs -0 -r dart format

[group('dev')]
fix:
    dart fix --apply

[group('dev')]
outdated:
    {{ TOOL }} pub outdated

[group('dev')]
clean:
    rm -rf .dart_tool build coverage reports

# Operator only: gate, bump, commit, push, wait for CI on that commit, then tag vX.Y.Z, which
# deploy.yml publishes. A tag on a commit CI has not passed would publish it anyway.
[group('operator')]
[script]
release version:
    [ -t 0 ] || { echo "release is an operator command: run it from a terminal"; exit 2; }
    case "{{ version }}" in [0-9]*.[0-9]*.[0-9]*) ;; *) echo "usage: just release 1.2.3"; exit 2 ;; esac
    [ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "commit or stash first: the tree is dirty"; exit 1; }
    grep -q "^## \[{{ version }}\]" CHANGELOG.md || { echo "CHANGELOG.md has no section for {{ version }}"; exit 1; }
    just check
    sed "s/^version: .*/version: {{ version }}/" pubspec.yaml > pubspec.yaml.tmp && mv pubspec.yaml.tmp pubspec.yaml
    git add pubspec.yaml
    git diff --cached --quiet || git commit --quiet -m "chore: release {{ version }}"
    git push --quiet origin HEAD
    sha="$(git rev-parse HEAD)"
    run=""
    for _ in $(seq 1 30); do
      run="$(gh run list --commit "$sha" --workflow ci.yml --json databaseId --jq '.[0].databaseId')"
      [ -n "$run" ] && break
      sleep 10
    done
    [ -n "$run" ] || { echo "no CI run for $sha within 5 minutes: tag it by hand once it is green"; exit 1; }
    gh run watch "$run" --exit-status || { echo "CI failed on $sha: not tagged"; exit 1; }
    git tag "v{{ version }}"
    git push --quiet origin "v{{ version }}"
    echo "pushed v{{ version }}"
