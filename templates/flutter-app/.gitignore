# dev_tool templates/flutter-app/.gitignore @2.0.0
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
coverage/
*.iml
.idea/

android/.gradle/
android/local.properties
android/key.properties
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
macos/Flutter/ephemeral/
windows/flutter/ephemeral/
linux/flutter/ephemeral/

*.aab
*.apk
**/*.jks
**/*.keystore

# Per-developer paths for the justfile; every env file except the two committed ones.
.env
.env.*
!.env.example
config/*.env
!config/development.env
!config/production.env

# Anchored: an unanchored `reports/` swallowed `lib/reports/` on 2026-09-19.
/reports/
dcm_analyze_report/
test/**/failures/
tool/**/failures/
integration_test/**/failures/
__pycache__/
*.py[cod]

pubspec_overrides.yaml

**/credentials.json
**/openai.key
*.p8
AuthKey*
**/private_keys/
.claude/settings.local.json
.claude/scheduled_tasks.lock
