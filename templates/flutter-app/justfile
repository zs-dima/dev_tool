# dev_tool templates/flutter-app/justfile @2.0.0
# Copied once, then this repository's own. Needs `sh` on PATH (Windows: Git for Windows' `Git\bin`).
# The workflows run the recipes their inputs name: `gen` (codegen), `gate-extra` (extra-checks),
# `build-appbundle` and `build-ios-config` (the releases). Per-developer settings (KIT, DEVICE) come
# from a gitignored `.env`.

set dotenv-load

DEVICE := env('DEVICE', '')
KIT := env('KIT', '')
DEFINES := '--dart-define-from-file=config/production.env --dart-define-from-file=config/keys.env'
DEBUG_DEFINES := '--dart-define-from-file=config/development.env'
SYMBOLS := '--obfuscate --split-debug-info=build/symbols'

# CI sets BUILD_NUMBER and BUILD_NAME; locally the number is the app's clock and the name the pubspec's version.
ANDROID_VERSION := '--build-number="${BUILD_NUMBER:-$(dart run dev_tool:build_number android)}" ${BUILD_NAME:+--build-name="$BUILD_NAME"}'
IOS_VERSION := '--build-number="${BUILD_NUMBER:-$(dart run dev_tool:build_number ios)}" ${BUILD_NAME:+--build-name="$BUILD_NAME"}'

default:
    @just --list

# What the gate runs after codegen, in its order.
[group('gate')]
check: format-check analyze gate-extra test test-android

# Hand-written Dart only: generated `*.*.dart` stays as its generator emits it.
[group('gate')]
format-check:
    git ls-files -z -- '*.dart' ':(exclude,glob)**/*.*.dart' | xargs -0 -r dart format --output=none --set-exit-if-changed

[group('gate')]
format:
    git ls-files -z -- '*.dart' ':(exclude,glob)**/*.*.dart' | xargs -0 -r dart format

[group('gate')]
analyze:
    flutter analyze

# This repository's own checks; CI runs them as `extra-checks: gate-extra`.
[group('gate')]
gate-extra:
    @echo "no repository checks yet"

# Every workspace package; `just test --only ui` scopes, `just test --no-coverage` is quicker.
[group('gate')]
test *args:
    dart run dev_tool:test_workspace {{ args }}

# The Android unit tests, where the app has any: part of the gate, as in CI and `takt check`.
[group('gate')]
[script]
test-android:
    [ -d android/app/src/test ] || exit 0
    [ -f android/gradlew ] || flutter build apk --config-only
    ./android/gradlew -p android --console=plain --quiet :app:testDebugUnitTest

# DCM with the arguments CI passes by default (`dcm: true` there).
[group('gate')]
dcm:
    dcm analyze . --no-fatal-warnings --no-fatal-style

# The code generators; CI runs this (`codegen-recipe: gen`) and compares the result with the tree.
# A generator outside build_runner goes below at a pinned version, with the Renovate annotation on
# the line above it: `# renovate: datasource=dart depName=pubspec_generator`, then
# `dart pub global activate pubspec_generator 5.0.2`.
[group('gen')]
gen:
    dart run build_runner build --workspace

[group('gen')]
gen-watch:
    dart run build_runner watch --workspace

[group('gen')]
gen-clean:
    dart run build_runner clean --workspace

[group('gen')]
get:
    flutter pub get

# config/keys.env is compiled into the app: only the keys dev_tool.keys allows.
[group('build')]
check-keys:
    dart run dev_tool:check_keys

# `just apk-debug --dart-define=X=Y` adds one-off defines.
[group('build')]
apk-debug *flags:
    flutter build apk --debug {{ DEBUG_DEFINES }} {{ flags }}

[group('build')]
build-android: check-keys
    flutter build apk --release {{ DEFINES }} {{ SYMBOLS }} {{ ANDROID_VERSION }}

# The Android release build.
[group('build')]
build-appbundle: check-keys
    flutter build appbundle --release {{ DEFINES }} {{ SYMBOLS }} {{ ANDROID_VERSION }}

[group('build')]
build-ios: check-keys
    flutter build ipa --release {{ DEFINES }} {{ SYMBOLS }} {{ IOS_VERSION }}

# The iOS release configures the project; xcodebuild archives, signs and uploads it.
[group('build')]
build-ios-config: check-keys
    flutter build ios --release --config-only {{ DEFINES }} {{ SYMBOLS }} {{ IOS_VERSION }}

# Against dev_tool.release.size_budget_mb.
[group('build')]
size-aab: build-appbundle
    dart run dev_tool:size_gate --file build/app/outputs/bundle/release/app-release.aab --label "local build"

# The Play card and the GitHub notes from CHANGELOG.md, into build/.
[group('build')]
release-notes version='':
    dart run dev_tool:release_notes {{ version }}

[group('device')]
run device=DEVICE:
    flutter run {{ if device != "" { "-d " + device } else { "" } }} {{ DEBUG_DEFINES }}

[group('device')]
integration device=DEVICE:
    flutter test integration_test {{ if device != "" { "-d " + device } else { "" } }} {{ DEBUG_DEFINES }}

# Kit packages from local checkouts (KIT in .env: a directory or a PATH-style list).
[group('deps')]
kit-link kit=KIT:
    test -n "{{ kit }}" || { echo "set KIT in .env (the kit checkouts directory)"; exit 2; }
    dart run dev_tool:kit link --kit "{{ kit }}"
    flutter pub get

# Back to the pinned versions.
[group('deps')]
kit-unlink:
    dart run dev_tool:kit unlink
    flutter pub get

[group('deps')]
outdated:
    flutter pub outdated

[group('deps')]
upgrade:
    flutter pub upgrade

[group('deps')]
clean:
    flutter clean
    rm -rf coverage reports
